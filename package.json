{
  "name": "telegram-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that owns a Telegram bot: webhook ingest to D1, Bot API and history over MCP",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:refresh": "node scripts/refresh-docs.mjs",
    "audit": "npm run build && node scripts/audit-registry.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "keywords": [
    "telegram",
    "bot-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/louietyj/telegram-gateway.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.156.2"
  }
}
